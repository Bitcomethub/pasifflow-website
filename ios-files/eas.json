{
    "cli": {
        "version": ">= 16.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "channel": "development",
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": true
            }
        },
        "preview": {
            "channel": "preview",
            "distribution": "internal",
            "ios": {
                "resourceClass": "m-medium"
            },
            "android": {
                "gradleCommand": ":app:assembleRelease"
            }
        },
        "production": {
            "channel": "production",
            "ios": {
                "resourceClass": "m-medium"
            },
            "android": {
                "gradleCommand": ":app:bundleRelease"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "ascAppId": "6757148739",
                "language": "tr-TR"
            },
            "android": {
                "track": "production"
            }
        }
    }
}
