+import AsyncStorage from '@react-native-async-storage/async-storage';
+import { Linking, Platform } from 'react-native';
+
+const REVIEW_STORAGE_KEY = 'pasiflow_review_state';
+const APP_STORE_ID = 'REPLACE_WITH_APP_STORE_ID';
+const SESSION_THRESHOLD = 3;
+
+interface ReviewState {
+    sessionCount: number;
+    hasPrompted: boolean;
+    lastPromptDate?: string;
+}
+
+async function getReviewState(): Promise<ReviewState> {
+    try {
+        const stored = await AsyncStorage.getItem(REVIEW_STORAGE_KEY);
+        return stored ? JSON.parse(stored) : { sessionCount: 0, hasPrompted: false };
+    } catch {
+        return { sessionCount: 0, hasPrompted: false };
+    }
+}
+
+async function saveReviewState(state: ReviewState): Promise<void> {
+    try {
+        await AsyncStorage.setItem(REVIEW_STORAGE_KEY, JSON.stringify(state));
+    } catch {
+        // Silent fail
+    }
+}
+
+/**
+ * Call this on app launch (e.g., in dashboard useEffect).
+ * After SESSION_THRESHOLD sessions, prompts for review once.
+ */
+export async function maybeRequestReview(): Promise<void> {
+    const state = await getReviewState();
+
+    // Already prompted — don't ask again
+    if (state.hasPrompted) return;
+
+    state.sessionCount += 1;
+    await saveReviewState(state);
+
+    if (state.sessionCount < SESSION_THRESHOLD) return;
+
+    try {
+        // Try expo-store-review first (native in-app review dialog)
+        const StoreReview = await import('expo-store-review');
+        const isAvailable = await StoreReview.isAvailableAsync();
+        if (isAvailable) {
+            await StoreReview.requestReview();
+            await saveReviewState({ ...state, hasPrompted: true, lastPromptDate: new Date().toISOString() });
+            return;
+        }
+    } catch {
+        // expo-store-review not installed — fallback to App Store link
+    }
+
+    // Fallback: open App Store page
+    if (Platform.OS === 'ios' && APP_STORE_ID !== 'REPLACE_WITH_APP_STORE_ID') {
+        const url = `https://apps.apple.com/app/id${APP_STORE_ID}?action=write-review`;
+        Linking.openURL(url).catch(() => {});
+        await saveReviewState({ ...state, hasPrompted: true, lastPromptDate: new Date().toISOString() });
+    }
+}
