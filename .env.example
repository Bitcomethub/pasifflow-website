# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"

# Demo User Credentials (bcrypt hashed passwords)
# Generate hashes with: node -e "console.log(require('bcryptjs').hashSync('password', 10))"
DEMO_USER_EMAIL="erman@pasiflow.com"
DEMO_USER_PASSWORD_HASH="$2a$10$..."

DEMO_CLIENT_EMAIL="demo@pasiflow.com"
DEMO_CLIENT_PASSWORD_HASH="$2a$10$..."

DEMO_AGENT_EMAIL="agent@pasiflow.com"
DEMO_AGENT_PASSWORD_HASH="$2a$10$..."

# SMTP Configuration (for email notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
ADMIN_EMAIL="info@pasiflow.com"

# OpenAI API Key (for chatbot)
OPENAI_API_KEY="sk-..."