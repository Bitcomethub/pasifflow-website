# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"

# ═══════════════════════════════════════════════════
# USER CREDENTIALS (Admin-provided, no self-registration)
# Generate hashes: node -e "console.log(require('bcryptjs').hashSync('password', 10))"
# ═══════════════════════════════════════════════════

# Agent Panel Credentials
DEMO_AGENT_EMAIL="agent@pasiflow.com"
DEMO_AGENT_PASSWORD_HASH="$2b$10$..."

# Investor/Client Panel Credentials
DEMO_INVESTOR_EMAIL="investor@pasiflow.com"
DEMO_INVESTOR_PASSWORD_HASH="$2b$10$..."

# Legacy demo users (optional, for backward compatibility)
DEMO_USER_EMAIL="erman@pasiflow.com"
DEMO_USER_PASSWORD_HASH="$2b$10$..."
DEMO_CLIENT_EMAIL="demo@pasiflow.com"
DEMO_CLIENT_PASSWORD_HASH="$2b$10$..."

# SMTP Configuration (for email notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
ADMIN_EMAIL="info@pasiflow.com"

# OpenAI API Key (for chatbot)
OPENAI_API_KEY="sk-..."

# Backend API URL (for Railway backend)
BACKEND_API_URL="https://pasiflow-api-production.up.railway.app"
